# --- Frontend (Vite) ---
# URL of the local photobooth backend. Leave unset to auto-use
# http://<same-host>:4000. Set this if the server runs elsewhere.
# VITE_API_URL=http://192.168.1.60:4000

# --- Backend (server/index.cjs) ---
# Port for the photo server (default 4000)
# PORT=4000
# Base URL embedded in the QR code. Defaults to http://<LAN-IP>:PORT,
# which works when phones are on the same Wi-Fi as the kiosk.
# PUBLIC_BASE_URL=http://192.168.1.60:4000
